{
  "name": "companion-module-cornerstone-stageutility",
  "version": "1.2.0-beta.1",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "husky",
    "format": "prettier -w .",
    "package": "run build && companion-module-build",
    "build": "yarn sync-manifest && rimraf dist && run build:main",
    "build:main": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint:raw": "eslint",
    "lint": "run lint:raw . && node scripts/sync-manifest.mjs --check",
    "sync-manifest": "node scripts/sync-manifest.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cornerstone-Production/companion-module-cornerstone-stageutility.git"
  },
  "engines": {
    "node": "^22.20",
    "yarn": "^4"
  },
  "dependencies": {
    "@companion-module/base": "^2.1.2",
    "eventsource": "^4.0.0"
  },
  "devDependencies": {
    "@companion-module/tools": "^3.0.2",
    "@types/node": "^26",
    "eslint": "^10",
    "husky": "^9.1.7",
    "lint-staged": "^17",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8"
  },
  "prettier": "@companion-module/tools/.prettierrc.json",
  "lint-staged": {
    "*.{css,json,md,scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "yarn lint:raw --fix"
    ]
  },
  "packageManager": "yarn@4.12.0",
  "stableVersion": "1.2.0"
}
